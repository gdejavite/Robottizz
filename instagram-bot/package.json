{
  "name": "instagram-comment-dm-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de comentário para direct do Instagram (Cloudflare Workers + KV)",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gerar-token": "node scripts/gerar-token.mjs",
    "configurar": "node scripts/configurar.mjs",
    "bot": "node scripts/bot.mjs",
    "menu": "node scripts/bot.mjs menu",
    "verificar": "node scripts/bot.mjs verificar",
    "aplicar": "node scripts/bot.mjs aplicar",
    "status": "node scripts/bot.mjs status",
    "publicar": "node scripts/bot.mjs publicar",
    "pacote": "git -C .. archive --format=zip --prefix=instagram-bot/ -o instagram-bot/instagram-bot.zip HEAD:instagram-bot"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
